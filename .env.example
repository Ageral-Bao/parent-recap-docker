# Copy to .env, next to docker-compose.yml, and fill in the address your family reaches the
# setup page on. docker compose reads it on its own; nothing here goes into the image.

# The address the page prints in the log: http://<your server's LAN address>:8090
SETUP_PUBLIC_URL=http://192.168.1.10:8090

# The port the page listens on, inside and outside the container.
SETUP_PORT=8090

# Pins the one-time code in the page's address, so it survives a restart and can be bookmarked.
# At least 16 characters of A-Z a-z 0-9 - _ . Leave it empty and a new one is made at every start,
# and the log has it.
SETUP_CODE=

# daily: the evening Brief (and the setup page beside it). setup: the setup page alone, which is
# what a Household with no config yet needs.
MODE=daily

# The Brief's hour, in the container's time zone (TZ, Europe/Helsinki by default).
DAILY_HOUR=20
DAILY_MINUTE=0
